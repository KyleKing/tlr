amends "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Config.pkl"

hooks {
    ["pre-commit"] {
        fix = true
        steps {
            // `presentations/` is npm/Vite territory: browser globals, npm bare specifiers,
            // and its own node_modules. Deno's linter and type checker cannot resolve it.
            ["biome"] {
                glob = List("*.ts", "*.js")
                exclude = "presentations/**"
                check = "deno task biome check {{files}}"
                fix = "deno task biome check --write {{files}}"
            }
            ["check"] {
                glob = "*.ts"
                check = "deno task check"
            }
            ["dprint"] {
                glob = List("*.json", "*.md", "*.toml")
                check = "dprint check {{files}}"
                fix = "dprint fmt {{files}}"
            }
            ["fmt"] {
                glob = List("*.ts", "*.js")
                exclude = "presentations/**"
                check = "deno task fmt --check {{files}}"
                fix = "deno task fmt {{files}}"
            }
            ["lint"] {
                glob = List("*.ts", "*.js")
                exclude = "presentations/**"
                check = "deno task lint {{files}}"
            }
            ["test"] {
                glob = "*_test.ts"
                check = "deno task test"
            }
            ["test:e2e"] {
                glob = "*.ts"
                check = "deno task test:e2e --project=chrome"
            }
        }
    }
}
