amends "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Config.pkl"

hooks {
    ["pre-commit"] {
        fix = true
        steps {
            ["dprint"] {
                glob = List("*.json", "*.md", "*.toml")
                check = "dprint check {{files}}"
                fix = "dprint fmt {{files}}"
            }
        }
    }
}
