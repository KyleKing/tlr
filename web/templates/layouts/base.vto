<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <nav class="topnav">
    <span class="brand">tlr</span>
    <a href="/" {{ if active === "board" }}aria-current="page"{{ /if }}>Board</a>
    <a href="/changes" {{ if active === "changes" }}aria-current="page"{{ /if }}>Changes</a>
    <a href="/review" {{ if active === "review" }}aria-current="page"{{ /if }}>Review</a>
    <a href="/roadmap" {{ if active === "roadmap" }}aria-current="page"{{ /if }}>Roadmap</a>
    <a href="/settings" {{ if active === "settings" }}aria-current="page"{{ /if }}>Settings</a>
    <select id="global-project-picker" class="nav-project-picker" hidden aria-label="Switch project"></select>
    {{ if demo }}<span class="demotag" title="Writes go to the free/test workspace">demo</span>{{ /if }}
  </nav>
  {{ if demo }}<div class="demobar" role="status">Demo mode — connected to the free/test workspace. Edits do not touch your real Linear.</div>{{ /if }}
  <div id="access-warning" class="access-warning" role="status" hidden></div>
  {{ content |> safe }}
  <script type="module" src="/lib/scheduleBanner.js"></script>
  <script type="module" src="{{ script }}"></script>
</body>
</html>
