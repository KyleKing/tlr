  <header class="page-head">
    <div>
      <h1 id="title">Changes</h1>
      <div class="sub" id="meta">Weekly update from the two most recent snapshots</div>
    </div>
    <button class="pill" id="capture">Capture snapshot</button>
  </header>
  <div class="snap-compare" id="snap-compare" hidden>
    <label>From <select id="snap-from"></select></label>
    <label>To <select id="snap-to"></select></label>
    <span class="snap-hint" id="snap-hint"></span>
  </div>
  <div id="page" class="page-body">
    <p class="empty">Loading…</p>
  </div>
