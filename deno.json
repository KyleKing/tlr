{
  "tasks": {
    "biome": "deno run --allow-read --allow-write --allow-env --allow-run @biomejs/biome",
    "capacity": "deno run --allow-read --allow-write --allow-env --allow-net=api.incident.io,accounts.google.com,oauth2.googleapis.com,www.googleapis.com,127.0.0.1 --allow-run=security,open ./scripts/capacity.ts",
    "check": "deno check .",
    "dev": "deno run --allow-net --allow-read --allow-write=./web/data --allow-env --allow-run=security,open ./scripts/serve.ts",
    "fmt": "deno fmt",
    "gcal:freebusy": "deno run --allow-read --allow-write --allow-net=accounts.google.com,oauth2.googleapis.com,www.googleapis.com,127.0.0.1 --allow-run=open ./scripts/gcal-freebusy.ts",
    "issues": "deno run --allow-read --allow-write --allow-env --allow-net=api.linear.app --allow-run=security ./scripts/issues.ts",
    "lint": "deno lint",
    "roster": "deno run --allow-read --allow-write --allow-env --allow-net=api.linear.app --allow-run=security ./scripts/roster.ts",
    "test": "deno test",
    "test:e2e": "deno run --allow-all npm:playwright test",
    "test:e2e:install": "deno install && deno run --allow-all npm:playwright install chromium --only-shell",
    "test:e2e:ui": "deno task test:e2e --ui"
  },
  "imports": {
    "@biomejs/biome": "npm:@biomejs/biome@^2.2.4",
    "@playwright/test": "npm:@playwright/test@^1.55.1",
    "hono": "npm:hono@^4.9.8",
    "vento/": "https://deno.land/x/vento@v2.4.0/"
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 120,
    "proseWrap": "preserve",
    "semiColons": false,
    "useTabs": false
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  }
}
